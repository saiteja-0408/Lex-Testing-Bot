{\n  \"name\": \"lex-web-ui-server\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Backend API server for Lex Web UI with microservices support\",\n  \"main\": \"src/index.js\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"node --watch src/index.js\",\n    \"start\": \"NODE_ENV=production node src/index.js\",\n    \"test\": \"jest\",\n    \"test:watch\": \"jest --watch\",\n    \"test:coverage\": \"jest --coverage\",\n    \"lint\": \"eslint src --ext .js\",\n    \"lint:fix\": \"eslint src --ext .js --fix\",\n    \"format\": \"prettier --write 'src/**/*.js'\",\n    \"migrate:latest\": \"knex migrate:latest\",\n    \"migrate:rollback\": \"knex migrate:rollback\",\n    \"seed:run\": \"knex seed:run\"\n  },\n  \"dependencies\": {\n    \"express\": \"^4.18.2\",\n    \"cors\": \"^2.8.5\",\n    \"dotenv\": \"^16.3.1\",\n    \"helmet\": \"^7.1.0\",\n    \"express-validator\": \"^7.0.0\",\n    \"winston\": \"^3.11.0\",\n    \"@aws-sdk/client-lex-runtime-v2\": \"^3.442.0\",\n    \"@aws-sdk/client-cognito-identity-provider\": \"^3.442.0\",\n    \"jsonwebtoken\": \"^9.1.2\",\n    \"uuid\": \"^9.0.1\",\n    \"axios\": \"^1.6.2\"\n  },\n  \"devDependencies\": {\n    \"eslint\": \"^8.54.0\",\n    \"prettier\": \"^3.1.0\",\n    \"jest\": \"^29.7.0\",\n    \"supertest\": \"^6.3.3\",\n    \"nodemon\": \"^3.0.2\"\n  },\n  \"engines\": {\n    \"node\": \">=18.0.0\",\n    \"npm\": \">=9.0.0\"\n  }\n}\n