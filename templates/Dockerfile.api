# ============================================================================
# Dockerfile for Lex Web UI API Server
# ============================================================================
# Multi-stage build for optimized production images
# 
# Build: docker build -f Dockerfile.api -t lex-web-ui-api .
# Run:   docker run -p 3000:3000 lex-web-ui-api
# ============================================================================

# ──────────────────────────────────────────────────────────────────────────
# Stage 1: Builder - Install dependencies and prepare application
# ──────────────────────────────────────────────────────────────────────────
FROM node:18-alpine AS builder

LABEL maintainer="Your Team <team@example.com>"
LABEL description="Lex Web UI API Server"

WORKDIR /app

# Install system dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    && rm -rf /var/cache/apk/*

# Copy package files
COPY package.json package-lock.json ./
COPY src/server/package.json src/server/

# Install dependencies
RUN npm ci && \
    npm ci -w src/server && \
    npm cache clean --force

# ──────────────────────────────────────────────────────────────────────────
# Stage 2: Development
# ──────────────────────────────────────────────────────────────────────────
FROM node:18-alpine AS development

WORKDIR /app

# Copy dependencies from builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/src/server/node_modules ./src/server/node_modules

# Copy source code
COPY src/server ./src/server
COPY src/server/package.json ./src/server/

# Install development dependencies
RUN npm install --only=dev

ENV NODE_ENV=development
ENV LOG_LEVEL=debug
EXPOSE 3000

CMD ["node", "--watch", "src/server/index.js"]

# ──────────────────────────────────────────────────────────────────────────
# Stage 3: Production
# ──────────────────────────────────────────────────────────────────────────
FROM node:18-alpine AS production

WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Copy dependencies from builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/src/server/node_modules ./src/server/node_modules

# Copy source code
COPY --chown=nodejs:nodejs src/server ./src/server
COPY --chown=nodejs:nodejs src/server/package.json ./src/server/

# Create logs directory
RUN mkdir -p /app/logs && \
    chown nodejs:nodejs /app/logs

# Set environment
ENV NODE_ENV=production
ENV LOG_LEVEL=info
EXPOSE 3000

# Switch to non-root user
USER nodejs

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

CMD ["node", "src/server/index.js"]

# ──────────────────────────────────────────────────────────────────────────
# Stage 4: Production with Debugging
# ──────────────────────────────────────────────────────────────────────────
FROM production AS production-debug

USER root

# Install debugging tools
RUN apk add --no-cache \
    bash \
    curl \
    wget \
    vim \
    && rm -rf /var/cache/apk/*

USER nodejs

CMD ["node", "--inspect=0.0.0.0:9229", "src/server/index.js"]
