  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.8",
    "vue": "^3.3.8",
    "@vue/test-utils": "^2.4.3",
    "vitest": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "jsdom": "^23.0.1",
    "@testing-library/vue": "^8.0.1",
    "eslint": "^8.54.0",
    "eslint-plugin-vue": "^9.18.1",
