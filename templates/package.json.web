{
  "name": "lex-web-ui-component",
  "version": "1.0.0",
  "description": "Vue.js Lex chatbot UI component with right-panel integration",
  "main": "dist/lex-web-ui.js",
  "types": "dist/lex-web-ui.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
