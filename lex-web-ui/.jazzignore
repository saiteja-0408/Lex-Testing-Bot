# .jazzignore (lex-web-ui/) — folder-local rules for the Vue app.
#
# {dist} here is lex-web-ui/dist — the INTERMEDIATE vite build output
# (bundle/ staging). It is regenerated by `npm run build-dist` and then
# copied to the top-level /dist by build/copy-assets.js. The top-level
# /dist is the real deployable and IS checked in — which is exactly why
# this ignore is folder-local (core.ignore) and not recursive.

core.ignore= \
  {dist} \
  {coverage}
